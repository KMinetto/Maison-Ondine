# ============================================================
#  Variables d'environnement — backend (Symfony + Docker)
# ============================================================
#  Ce fichier documente les variables surchargeables et leurs
#  valeurs par défaut (dev). Il n'est PAS lu automatiquement.
#
#  Où surcharger une valeur ?
#   - Variables applicatives Symfony  -> backend/.env.local (non versionné)
#   - Variables Docker Compose        -> exportées dans le shell, ou dans
#                                        backend/.env avant `docker compose up`
#
#  Les valeurs par défaut ci-dessous suffisent pour un dev local :
#  la stack démarre sans rien copier (`docker compose up -d`).
# ------------------------------------------------------------

##> Symfony
APP_ENV=dev
# À définir dans .env.local (générer : `php bin/console secrets:generate-keys`
# ou une chaîne aléatoire). Laissé vide par défaut en dev.
APP_SECRET=

##> Base de données (PostgreSQL)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!
POSTGRES_VERSION=16
POSTGRES_CHARSET=utf8
# Depuis un conteneur, l'hôte de la base est le service `database`.
# En exécution hors Docker (CLI sur l'hôte), remplacer par 127.0.0.1.
DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/app?serverVersion=16&charset=utf8"

##> Serveur web (FrankenPHP / Caddy)
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443

##> Outils de développement
# Interface Adminer (admin BDD) : http://localhost:${ADMINER_PORT}
ADMINER_PORT=8080
# Xdebug : off | develop | debug | ... (cf. https://xdebug.org/docs/all_settings#mode)
XDEBUG_MODE=develop
