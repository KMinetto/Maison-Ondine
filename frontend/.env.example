# ============================================================
#  Variables d'environnement — frontend (Nuxt)
# ============================================================
#  Copier ce fichier en `.env` (non versionné) pour surcharger
#  les valeurs par défaut en local :
#      cp .env.example .env
#
#  Les clés publiques (NUXT_PUBLIC_*) sont exposées côté client
#  et alimentent runtimeConfig.public dans nuxt.config.ts.
# ------------------------------------------------------------

# URL de base de l'API backend (Symfony / FrankenPHP)
NUXT_PUBLIC_API_BASE=https://localhost
